rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    function isValidProductImage() {
      return request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png'];
    }

    match /productos/{imageName} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && isValidProductImage();
      allow delete: if isAdmin();
    }
  }
}