rules_version = '2';

// Prototype data model:
// usuarios/{uid}: uid, email, rol (admin|cliente), clienteId, creadoEn.
// clientes/{id}: uid, nombre, telefono, correo, usuario, membresia,
// fechaInicio, notas, estado, estadoPago, contrasena, creadoEn. Client records
// are readable by administrators and by an authenticated client whose UID or
// email matches the profile.
// asistencias/{fecha_clienteId}: uid, clienteId, nombre, usuario, membresia,
// estadoMembresia, fechaClave (YYYY-MM-DD), hora (HH:mm), registroQr, creadoEn.
// Administrative collections (planes, pagos, ventas, gastos, inventario, etc.)
// are accessed only by an administrator.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function getClientAccountPath() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }

    function isOwnAttendanceDocument(attendanceId) {
      let accountPath = getClientAccountPath();
      let account = get(accountPath).data;
      return signedIn()
        && exists(accountPath)
        && account.rol == 'cliente'
        && account.clienteId is string
        && account.clienteId.size() > 0
        && account.clienteId.matches('^[A-Za-z0-9_-]{1,128}$')
        && request.auth.uid.matches('^[A-Za-z0-9_-]{1,128}$')
        && (
          attendanceId.matches('^\\d{4}-\\d{2}-\\d{2}_' + account.clienteId + '(_qr)?$')
          || attendanceId.matches('^\\d{4}-\\d{2}-\\d{2}_' + request.auth.uid + '$')
        );
    }

    function managuaDateKey() {
      let localDate = request.time - duration.value(6, 'h');
      let month = localDate.month();
      let day = localDate.day();
      return string(localDate.year())
        + '-' + (month < 10 ? '0' : '') + string(month)
        + '-' + (day < 10 ? '0' : '') + string(day);
    }

    function hasActiveClientMembership(client) {
      let membership = ('membresia' in client && client.membresia is string)
        ? client.membresia
        : (('tipoMembresia' in client && client.tipoMembresia is string)
          ? client.tipoMembresia
          : '');
      let paymentStatus = ('estadoPago' in client && client.estadoPago is string)
        ? client.estadoPago.lower()
        : '';
      let clientStatus = ('estado' in client && client.estado is string)
        ? client.estado.lower()
        : '';
      return membership.size() > 0
        && paymentStatus in ['pagado', 'paid', 'activo', 'activa', 'vigente']
        && clientStatus != 'inactivo'
        && clientStatus != 'suspendido'
        && (
          !('fechaVencimiento' in client)
          || (
            client.fechaVencimiento is string
            && (
              client.fechaVencimiento == ''
              || (
                client.fechaVencimiento.matches('^\\d{4}-\\d{2}-\\d{2}$')
                && client.fechaVencimiento >= managuaDateKey()
              )
            )
          )
        );
    }

    function isValidClientQrAttendance(attendanceId, data) {
      let accountPath = getClientAccountPath();
      let account = get(accountPath).data;
      let clientPath = /databases/$(database)/documents/clientes/$(account.clienteId);
      let client = get(clientPath).data;
      let clientName = ('nombre' in client && client.nombre is string)
        ? client.nombre.trim()
        : '';
      let clientUsername = ('usuario' in client && client.usuario is string)
        ? client.usuario.trim()
        : (('username' in client && client.username is string) ? client.username.trim() : '');
      let clientMembership = ('membresia' in client && client.membresia is string)
        ? client.membresia.trim()
        : (('tipoMembresia' in client && client.tipoMembresia is string) ? client.tipoMembresia.trim() : '');
      let clientMembershipState = ('estadoPago' in client && client.estadoPago is string && client.estadoPago != '')
        ? client.estadoPago.trim()
        : (('estado' in client && client.estado is string && client.estado != '')
          ? client.estado.trim()
          : 'Activa');
      return signedIn()
        && exists(accountPath)
        && account.rol == 'cliente'
        && account.clienteId is string
        && account.clienteId.size() > 0
        && exists(clientPath)
        && client.uid == request.auth.uid
        && hasActiveClientMembership(client)
        && data.keys().hasAll([
          'uid', 'clienteId', 'nombre', 'usuario', 'membresia',
          'estadoMembresia', 'fechaClave', 'hora', 'registroQr', 'creadoEn'
        ])
        && data.keys().hasOnly([
          'uid', 'clienteId', 'nombre', 'usuario', 'membresia',
          'estadoMembresia', 'fechaClave', 'hora', 'registroQr', 'creadoEn'
        ])
        && data.uid == request.auth.uid
        && data.clienteId == account.clienteId
        && data.fechaClave == managuaDateKey()
        && data.hora is string
        && data.hora.matches('^([01]\\d|2[0-3]):[0-5]\\d$')
        && data.nombre is string
        && data.nombre.size() <= 120
        && data.nombre == clientName
        && data.usuario is string
        && data.usuario.size() <= 80
        && data.usuario == clientUsername
        && data.membresia is string
        && data.membresia.size() <= 80
        && data.membresia == clientMembership
        && data.estadoMembresia is string
        && data.estadoMembresia.size() <= 40
        && data.estadoMembresia == clientMembershipState
        && data.registroQr == true
        && data.creadoEn == request.time
        && attendanceId == data.fechaClave + '_' + account.clienteId + '_qr';
    }

    function isAuthenticatedClientProfile(data) {
      return signedIn()
        && (
          data.uid == request.auth.uid
          || (
            request.auth.token.email is string
            && data.correo == request.auth.token.email
          )
        );
    }

    function validShortString(data, field, maxLength) {
      return !(field in data)
        || (data[field] is string && data[field].size() <= maxLength);
    }

    function validEmail(value) {
      return value is string
        && value.size() <= 254
        && value.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$');
    }

    function validUserProfile(data) {
      return data.keys().hasOnly(['uid', 'email', 'rol', 'clienteId', 'creadoEn'])
        && data.uid is string
        && data.uid.size() <= 128
        && validEmail(data.email)
        && data.rol in ['admin', 'cliente']
        && validShortString(data, 'clienteId', 128)
        && (!('creadoEn' in data) || data.creadoEn is timestamp);
    }

    function validClient(data) {
      return data.keys().hasOnly([
          'uid', 'nombre', 'apellido', 'telefono', 'correo', 'usuario',
          'username', 'membresia', 'tipoMembresia', 'fechaInicio',
          'fechaVencimiento', 'fechaNacimiento', 'fechaRegistro', 'creadoEn',
          'notas', 'estado', 'estadoPago', 'contrasena'
        ])
        && validShortString(data, 'uid', 128)
        && validShortString(data, 'nombre', 120)
        && validShortString(data, 'apellido', 120)
        && validShortString(data, 'telefono', 32)
        && (!('correo' in data) || data.correo == '' || validEmail(data.correo))
        && validShortString(data, 'usuario', 80)
        && validShortString(data, 'username', 80)
        && validShortString(data, 'membresia', 80)
        && validShortString(data, 'tipoMembresia', 80)
        && validShortString(data, 'fechaInicio', 40)
        && validShortString(data, 'fechaVencimiento', 40)
        && validShortString(data, 'fechaNacimiento', 40)
        && validShortString(data, 'notas', 1000)
        && validShortString(data, 'contrasena', 128)
        && (!('estado' in data) || data.estado in ['Activo', 'activo', 'Inactivo', 'inactivo'])
        && (!('estadoPago' in data) || data.estadoPago in ['pagado', 'pendiente', 'vencido'])
        && (!('creadoEn' in data) || data.creadoEn is timestamp)
        && (!('fechaRegistro' in data) || data.fechaRegistro is timestamp || data.fechaRegistro is string);
    }

    match /usuarios/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isAdmin() && validUserProfile(request.resource.data);
      allow delete: if isAdmin();
    }

    match /clientes/{clienteId} {
      allow get: if isAdmin() || isAuthenticatedClientProfile(resource.data);
      allow list: if isAdmin() || isAuthenticatedClientProfile(resource.data);
      allow create, update: if isAdmin() && validClient(request.resource.data);
      allow delete: if isAdmin();
    }

    match /asistencias/{attendanceId} {
      allow get: if isAdmin() || isOwnAttendanceDocument(attendanceId);
      allow list: if isAdmin();
      allow create: if isAdmin() || isValidClientQrAttendance(attendanceId, request.resource.data);
      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}